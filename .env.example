# Copiaza fisierul asta ca ".env" si pune cheile tale.
# Daca lasi totul gol, aplicatia porneste in MOD DEMO.

PORT=3000

# Apify - cont gratuit pe loc, fara card, $5 credit/luna (~250 cautari)
# Cont: https://console.apify.com/sign-up  -> Settings -> API & Integrations -> copiezi "Personal API token"
APIFY_TOKEN=

# RegCheck - cel mai rapid de pornit (cont cu email, 10 cautari gratuite, apoi platit)
# Cont: https://www.regcheck.org.uk/   -> pui aici username-ul contului
REGCHECK_USERNAME=

# DVLA Vehicle Enquiry Service (gratuit)
# Cerere cheie: https://register-for-ves.driver-vehicle-licensing.api.gov.uk/
DVLA_API_KEY=

# DVSA MOT History API (gratuit)
# Cerere: https://documentation.history.mot.api.gov.uk/mot-history-api/register
# Primesti pe email toate valorile de mai jos
MOT_CLIENT_ID=
MOT_CLIENT_SECRET=
MOT_API_KEY=
MOT_TOKEN_URL=
MOT_SCOPE=https://tapi.dvsa.gov.uk/.default

# ================= EMAIL (SMTP) =================
# Trimite polita pe emailul clientului. Merge cu orice provider SMTP.
#
# --- Varianta Gmail (gratuit) ---
# 1) In contul Google: Security -> activeaza "2-Step Verification"
# 2) Tot acolo -> "App passwords" -> genereaza o parola de aplicatie (16 caractere)
# 3) Completeaza:
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=465
#    SMTP_USER=adresa_ta@gmail.com
#    SMTP_PASS=parola_de_aplicatie_de_16_caractere
#    SENDER_EMAIL=adresa_ta@gmail.com
#    SENDER_NAME=DriveCover
#
# --- Outlook/Hotmail --- SMTP_HOST=smtp-mail.outlook.com  SMTP_PORT=587
# --- Brevo SMTP --------- SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587 (user+key din Brevo)

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=
SENDER_NAME=DriveCover
